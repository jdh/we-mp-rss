# ==========================================
# We-MP-RSS 云服务器部署配置
# ==========================================

# 系统时区
TZ=Asia/Shanghai

# Web服务端口
WEB_PORT=8001

# ==========================================
# 数据库配置
# ==========================================
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=we_mp_rss
MYSQL_USER=rss_user
MYSQL_PASSWORD=your_db_password_here

# ==========================================
# 应用登录账号
# ==========================================
USERNAME=admin
PASSWORD=your_admin_password_here

# ==========================================
# 其他配置
# ==========================================
# 代码变更自动重启（生产环境建议关闭）
AUTO_RELOAD=False
